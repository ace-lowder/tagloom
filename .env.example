# Required: Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required: Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required: OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Required: Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_SINGLE_USE_PRICE_ID=price_starter_one_time
STRIPE_MONTHLY_PRICE_ID=price_monthly_recurring
STRIPE_YEARLY_PRICE_ID=price_yearly_recurring
STRIPE_SUCCESS_URL=http://localhost:3000/
STRIPE_CANCEL_URL=http://localhost:3000/

# Optional: Stripe billing
STRIPE_BILLING_RETURN_URL=http://localhost:3000/billing
STRIPE_STARTER_UPGRADE_COUPON_ID=

# Required: Rate limit / bot checks
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Required: Email/support
RESEND_API_KEY=your-resend-api-key
SUPPORT_FROM_EMAIL="UpdateTags Support <support@updatetags.com>"
SUPPORT_TO_EMAIL=support@updatetags.com

# Optional: Playwright/local smoke
PLAYWRIGHT_E2E_EMAIL=your-test-user@example.com
PLAYWRIGHT_E2E_PASSWORD=your-test-password
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_DISABLE_SIGNUP_IP_LIMIT=false
